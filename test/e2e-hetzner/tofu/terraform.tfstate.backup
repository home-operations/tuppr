    \"name\": \"static_layer_0\",\n            \"staticLayer\": {\n              \"overload\": {\n                \"global_downstream_max_connections\": 50000\n              }\n            }\n          }\n        ]\n      },\n      \"admin\": {\n        \"address\": {\n          \"pipe\": {\n            \"path\": \"/var/run/cilium/envoy/sockets/admin.sock\"\n          }\n        }\n      }\n    }\nkind: ConfigMap\nmetadata:\n  name: cilium-envoy-config\n  namespace: kube-system\n","yaml_incluster":"apiVersion=3bfc269594ef649228e9a74bab00f042efc91d5acc6fbee31a382e80d42388fe\ndata.bootstrap-config.json=33a8a77322bd23a657f714b0defecd5ee960335b8940f0584a454011aafdec2f\nkind=0fbccfa7e82773d5a67ff9cb176c9b3bc9ce8b1c09b470f0bc402d6cdaef12dd\nmetadata.name=8e5a8acadfbbf147e287a4dfb562c3647015df4c50f26de7fe53ae42e0938cca\nmetadata.namespace=88007f70666dbd81a8d2e5ca15851947c692613660b4f6148f7ad8c7130e1e5a"},"sensitive_attributes":[[{"type":"get_attr","value":"live_manifest_incluster"}],[{"type":"get_attr","value":"yaml_body"}],[{"type":"get_attr","value":"yaml_incluster"}]],"private":"eyJlMmJmYjczMC1lY2FhLTExZTYtOGY4OC0zNDM2M2JjN2M0YzAiOnsiY3JlYXRlIjo2MDAwMDAwMDAwMDB9LCJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["hcloud_load_balancer.kube_api","module.talos_cluster.data.hcloud_floating_ip.control_plane_ipv4","module.talos_cluster.data.hcloud_image.arm","module.talos_cluster.data.hcloud_image.x86","module.talos_cluster.data.hcloud_location.selected","module.talos_cluster.data.hcloud_locations.all","module.talos_cluster.data.helm_template.cilium_default","module.talos_cluster.data.helm_template.cilium_from_values","module.talos_cluster.data.http.personal_ipv4","module.talos_cluster.data.http.personal_ipv6","module.talos_cluster.data.http.talos_health","module.talos_cluster.data.kubectl_file_documents.cilium","module.talos_cluster.data.talos_machine_configuration.control_plane","module.talos_cluster.hcloud_firewall.this","module.talos_cluster.hcloud_floating_ip.control_plane