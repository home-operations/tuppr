{"version":4,"terraform_version":"1.11.4","serial":8,"lineage":"25e43c5e-4a26-13f9-2bbb-b6e767d89afb","outputs":{"cluster_name":{"value":"tuppr-e2e-local-3cp-0w","type":"string"},"control_plane_ips":{"value":["46.225.167.153","46.225.169.147","46.225.162.194"],"type":["tuple",["string","string","string"]]},"k8s_upgrade_version":{"value":"v1.35.0","type":"string"},"kubeconfig_path":{"value":"/tmp/tuppr-e2e-local/kubeconfig","type":"string"},"load_balancer_ip":{"value":"46.225.36.135","type":"string"},"talos_upgrade_version":{"value":"v1.12.4","type":"string"},"talosconfig_path":{"value":"/tmp/tuppr-e2e-local/talosconfig","type":"string"}},"resources":[{"mode":"managed","type":"hcloud_load_balancer","name":"kube_api","provider":"provider[\"registry.opentofu.org/hetznercloud/hcloud\"]","instances":[{"schema_version":0,"attributes":{"algorithm":[{"type":"round_robin"}],"delete_protection":false,"id":"5841784","ipv4":"46.225.36.135","ipv6":"2a01:4f8:1c1f:6fe8::1","labels":{"control-plane-count":"3","managed-by":"tuppr-e2e","run-id":"local","worker-count":"0"},"load_balancer_type":"lb11","location":"nbg1","name":"tuppr-e2e-local-3cp-0w-lb","network_id":null,"network_ip":null,"network_zone":"eu-central","target":[]},"sensitive_attributes":[],"private":"bnVsbA=="}]},{"mode":"managed","type":"hcloud_load_balancer_service","name":"kube_api","provider":"provider[\"registry.opentofu.org/hetznercloud/hcloud\"]","instances":[{"schema_version":0,"attributes":{"destination_port":6443,"health_check":[{"http":[],"interval":10,"port":6443,"protocol":"tcp","retries":3,"timeout":5}],"http":null,"id":"5841784__6443","listen_port":6443,"load_balancer_id":"5841784","protocol":"tcp","proxyprotocol":false},"sensitive_attributes":[],"private":"bnVsbA==","dependencies":["hcloud_load_balancer.kube_api"]}]},{"mode":"managed","type":"hcloud_load_balancer_target","name":"control_planes","provider":"provider[\"registry.opentofu.org/hetznercloud/hcloud\"]","instances":[{"schema_version":0,"attributes":{"id":"lb-label-selector-tgt-e65fac8e47ed6ef7c9b62dadd2e9838db53685e7720a490314729c02ba12823f-5841784","ip":null,"label_selector":"cluster=tuppr-e2e-local-3cp-0w,role=control-plane","load_balancer_id":5841784,"server_id":null,"type":"label_selector","use_private_ip":false},"sensitive_attributes":[],"private":"bnVsbA==","dependencies":["hcloud_load_balancer.kube_api"]}]},{"mode":"managed","type":"local_file","name":"kubeconfig","provider":"provider[\"registry.opentofu.org/hashicorp/local\"]","instances":[{"schema_version":0,"attributes":{"content":"apiVersion: v1\nclusters:\n- cluster:\n    certificate-authority-data: \n    server: https://46.225.36.135:6443\n  name: tuppr-e2e-local-3cp-0w\ncontexts:\n- context:\n    cluster: tuppr-e2e-local-3cp-0w\n    namespace: default\n    user: admin@tuppr-e2e-local-3cp-0w\n  name: admin@tuppr-e2e-local-3cp-0w\ncurrent-context: admin@tuppr-e2e-local-3cp-0w\nkind: Config\nusers:\n- name: admin@tuppr-e2e-local-3cp-0w\n  user:\n    client-certificate-data: \n    client-key-data: \n","content_base64":null,"content_base64sha256":"qe10BVtGox96VTRd/g5mq5TK+EZCJ0im75goaYF4EI8=","content_base64sha512":"LkV3VcLKKKDLMqjYwF006kFslpYsDnb07Tu7AqQgeszPcs5iFYA7mTvPckVn3A0LHL7GQXtSi78poK+mvoNSLA==","content_md5":"9c4af05b8923172ecba6928e68f51417","content_sha1":"b753c74d4aeee970fea7f1eaac8c861ac5c7f325","content_sha256":"a9ed74055b46a31f7a55345dfe0e66ab94caf846422748a6ef9828698178108f","content_sha512":"2e457755c2ca28a0cb32a8d8c05d34ea416c96962c0e76f4ed3bbb02a4207acccf72ce6215803b993bcf724567dc0d0b1cbec6417b528bbf29a0afa6be83522c","directory_permission":"0777","file_permission":"0600","filename":"/tmp/tuppr-e2e-local/kubeconfig","id":"b753c74d4aeee970fea7f1eaac8c861ac5c7f325","sensitive_content":null,"source":null},"sensitive_attributes":[[{"type":"get_attr","value":"content"}],[{"type":"get_attr","value":"sensitive_content"}]],"dependencies":["hcloud_load_balancer.kube_api","module.talos_cluster.data.hcloud_floating_ip.control_plane_ipv4","module.talos_cluster.data.hcloud_image.arm","module.talos_cluster.data.hcloud_image.x86","module.talos_cluster.data.hcloud_location.selected","module.talos_cluster.data.hcloud_locations.all","module.talos_cluster.data.http.personal_ipv4","module.talos_cluster.data.http.personal_ipv6","module.talos_cluster.data.talos_machine_configuration.control_plane","module.talos_cluster.hcloud_firewall.this","module.talos_cluster.hcloud_floating_ip.control_plane_ipv4","module.talos_cluster.hcloud_network.this","module.talos_cluster.hcloud_network_subnet.nodes","module.talos_cluster.hcloud_placement_group.control_plane","module.talos_cluster.hcloud_primary_ip.control_plane_ipv4","module.talos_cluster.hcloud_primary_ip.control_plane_ipv6","module.talos_cluster.hcloud_server.control_planes","module.talos_cluster.hcloud_ssh_key.this","module.talos_cluster.talos_cluster_kubeconfig.this","module.talos_cluster.talos_machine_bootstrap.this","module.talos_cluster.talos_machine_secrets.this","module.talos_cluster.tls_private_key.ssh_key"]}]},{"mode":"managed","type":"local_file","name":"talosconfig","provider":"provider[\"registry.opentofu.org/hashicorp/local\"]","instances":[{"schema_version":0,"attributes":{"content":"context: tuppr-e2e-local-3cp-0w\ncontexts:\n    tuppr-e2e-local-3cp-0w:\n        endpoints:\n            - 46.225.167.153\n            - 46.225.169.147\n            - 46.225.162.194\n        ca: \n        crt: \n        key: LS0tLS1CRUdJTiBFRDI1NTE5IFBSSVZBVEUgS0VZLS0tLS0KTUM0Q0FRQXdCUVlESzJWd0JDSUVJRmc5L1RBT215ak1yVWFsVWdrNW9abXhwWlE1YnpUcXlxb0thWHJkemZxbAotLS0tLUVORCBFRDI1NTE5IFBSSVZBVEUgS0VZLS0tLS0K\n","content_base64":null,"content_base64sha256":"Sv9fDEHe3wHbYY5jEMjqSJo5H9PMFAf94stLWV80shE=","content_base64sha512":"jwSKbnI5pdKSNaEjANsHXnM8Wc9mqHZOAVRZpl63GvBA7yp2SI6yCqQpe14Hsy1vMZHqTUnfVux+Xl/Vtp0a/Q==","content_md5":"d3ac68739f543754d1723f5c5a3546f9","content_sha1":"19fce47dc26384442653822d43ce3d827ace4bb9","content_sha256":"4aff5f0c41dedf01db618e6310c8ea489a391fd3cc14