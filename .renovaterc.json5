{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["local>home-operations/.github:renovate-config"],
  packageRules: [
    {
      groupName: "Talos Group",
      matchPackageNames: [
        "github.com/siderolabs/talos/pkg/machinery",
        "ghcr.io/siderolabs/talos",
        // talosctl from mise; Renovate looks it up as this GitHub repo.
        "siderolabs/talos",
      ],
    },
  ],
  postUpdateOptions: ["gomodTidy", "gomodUpdateImportPaths"],
}
